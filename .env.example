# =============================================================================
# HatunSales API — plantilla de variables de entorno
# =============================================================================
# Archivo SEGURO para Git (sin secretos reales).
#
# DÓNDE PONER CADA COSA
# ---------------------
# 1) PRODUCCIÓN (lo que usas hoy)
#    Railway → tu servicio Nest (hatunsales-production) → Variables
#    Ahí pegas los mismos nombres (JWT_SECRET, DATABASE_URL, etc.).
#    El front (Vercel/Angular) NO lee este archivo; llama a:
#      https://hatunsales-production.up.railway.app/
#    (eso está en ferreteria/src/app/constants/urlConstants.ts)
#
# 2) RESPALDO EN TU PC
#    Copia este archivo a .env.local (o .env), rellena valores reales.
#    .env y .env.local están en .gitignore → NO se suben a GitHub.
#
# 3) CORRER NEST EN LOCAL
#    Nest carga por defecto el archivo ".env" (import 'dotenv/config' en main.ts).
#    Si solo tienes .env.local, copia:  cp .env.local .env
#    (o deja ambos iguales).
#
# 4) NO PONER AQUÍ
#    - Password de GitHub / Vercel
#    - URL del front (va en CORS_ORIGIN y en urlConstants del Angular)
#    - caja_modo / tienda_id_almacen → van en tabla configuraciones (BD), no en env
# =============================================================================

# --- Runtime ---
NODE_ENV=development
# Puerto del API Nest (Angular suele ser 4200; no lo mezcles)
PORT=3000
# true si sirves HTTPS / cookies Secure detrás de proxy
COOKIE_SECURE=false

# --- Base de datos PostgreSQL (Railway Postgres) ---
# Opción A (recomendada): URL completa
# Railway → Postgres → Variables → DATABASE_URL
# o: Postgres linkeado al servicio Nest → Reference Variable
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Opción B: partes sueltas (si no usas DATABASE_URL)
PGHOST=xxxxx.proxy.rlwy.net
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_password_aqui
PGDATABASE=railway

# --- JWT (obligatorio en Railway / producción) ---
# Railway → Nest → Variables → JWT_SECRET
# Debe ser largo y aleatorio. El mismo valor en Railway y en tu respaldo local.
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_STAFF=12h
JWT_EXPIRES_CLIENTE=2h

# --- CORS (producción) ---
# Orígenes del front permitidos, separados por coma (sin espacio raro al final)
# Ejemplo Vercel: https://hatunsales-sa.vercel.app
# Local + prod:
CORS_ORIGIN=http://localhost:4200,https://TU-FRONT.vercel.app

# --- Nubefact (comprobantes electrónicos) ---
# Panel Nubefact → API. En prod: Railway Variables (no dejar defaults en código).
NUBEFACT_URL=https://api.nubefact.com/api/v1/TU_RUTA
NUBEFACT_TOKEN=tu_token_nubefact

# --- Datos emisor (factura; pueden coincidir con Nubefact) ---
EMISOR_RUC=20XXXXXXXXX
EMISOR_RAZON_SOCIAL=HATUNSALES S.A.C.
EMISOR_DIRECCION=tu direccion
EMISOR_UBICACION=DISTRITO - PROVINCIA - DEPARTAMENTO
EMISOR_LOGO_URL=

# --- Consulta DNI/RUC (ApiPeru u otro) ---
SUNAT_TOKEN=tu_token_consulta
# SUNAT_DNI_URL=https://apiperu.dev/api/dni
# SUNAT_RUC_URL=https://apiperu.dev/api/ruc

# --- Culqi (pagos tienda; vacío = flujo sin pasarela / manual) ---
PASARELA_PROVEEDOR=simulada
PASARELA_MONEDA=PEN
CULQI_URL=https://api.culqi.com/v2
CULQI_PUBLIC_KEY=pk_test_o_pk_live_xxxx
CULQI_SECRET_KEY=sk_test_o_sk_live_xxxx
CULQI_WEBHOOK_SECRET=tu_webhook_secret
CULQI_TIMEOUT_MS=20000

# --- WhatsApp Business Meta Cloud (cotizaciones) — opcional ---
# Sin esto: el front abre wa.me (vendedor envía a mano). Así trabajan la mayoría de ferreterías.
# Con esto: POST /proforma/whatsapp/enviar usa Cloud API oficial (como Culqi: pegar en Railway).
# Meta Business → App → WhatsApp → API Setup → Phone number ID + token permanente.
# Fuera de ventana 24h Meta exige plantilla aprobada con 3 vars: {{1}}nombre {{2}}código {{3}}total.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_TEMPLATE_NAME=cotizacion_hatun
# WHATSAPP_TEMPLATE_LANG=es_PE

# --- Google login (opcional) ---
GOOGLE_CLIENT_ID=

# --- Imágenes (local o Cloudinary) ---
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=cloudinary
PRODUCT_IMAGES_PATH=uploads/products
PRODUCT_IMAGES_URL=/uploads
IMAGEN_TAMANIO_MAXIMO=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA=hatunsales/productos

# =============================================================================
# Checklist Railway (servicio Nest)
# =============================================================================
# [ ] JWT_SECRET
# [ ] DATABASE_URL (o PG* / link a Postgres)
# [ ] CORS_ORIGIN = URL exacta del front en Vercel
# [ ] NUBEFACT_URL + NUBEFACT_TOKEN (si emites CPE)
# [ ] CULQI_* (solo si cobras con Culqi)
# [ ] PORT lo pone Railway solo (no hace falta pelearlo)
#
# Tras cambiar Variables → Redeploy del servicio Nest.
# =============================================================================
