# =============================================================================
# HatunSales API — plantilla de variables de entorno
# =============================================================================
# Archivo SEGURO para Git (sin secretos reales).
#
# DÓNDE PONER CADA COSA
# ---------------------
# 1) PRODUCCIÓN (lo que usas hoy)
#    Railway → tu servicio Nest (hatunsales-production) → Variables
#    Ahí pegas los mismos nombres (JWT_SECRET, DATABASE_URL, etc.).
#    El front (Vercel/Angular) NO lee este archivo; llama a:
#      https://hatunsales-production.up.railway.app/
#    (eso está en ferreteria/src/app/constants/urlConstants.ts)
#
# 2) RESPALDO EN TU PC
#    Copia este archivo a .env.local (o .env), rellena valores reales.
#    .env y .env.local están en .gitignore → NO se suben a GitHub.
#
# 3) CORRER NEST EN LOCAL
#    Nest carga por defecto el archivo ".env" (import 'dotenv/config' en main.ts).
#    Si solo tienes .env.local, copia:  cp .env.local .env
#    (o deja ambos iguales).
#
# 4) NO PONER AQUÍ
#    - Password de GitHub / Vercel
#    - URL del front (va en CORS_ORIGIN y en urlConstants del Angular)
#    - caja_modo / tienda_id_almacen → van en tabla configuraciones (BD), no en env
# =============================================================================

# --- Runtime ---
NODE_ENV=development
# Puerto del API Nest (Angular suele ser 4200; no lo mezcles)
PORT=3000
# true si sirves HTTPS / cookies Secure detrás de proxy
COOKIE_SECURE=false

# --- Base de datos PostgreSQL (Railway Postgres) ---
# Opción A (recomendada): URL completa
# Railway → Postgres → Variables → DATABASE_URL
# o: Postgres linkeado al servicio Nest → Reference Variable
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Opción B: partes sueltas (si no usas DATABASE_URL)
PGHOST=xxxxx.proxy.rlwy.net
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_password_aqui
PGDATABASE=railway

# --- JWT (obligatorio en Railway / producción) ---
# Railway → Nest → Variables → JWT_SECRET
# Debe ser largo y aleatorio. El mismo valor en Railway y en tu respaldo local.
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_STAFF=12h
JWT_EXPIRES_CLIENTE=2h

# --- CORS (producción) ---
# Orígenes del front permitidos, separados por coma (sin espacio raro al final)
# Ejemplo Vercel: https://hatunsales-sa.vercel.app
# Local + prod:
CORS_ORIGIN=http://localhost:4200,https://TU-FRONT.vercel.app

# --- Nubefact (comprobantes electrónicos) ---
# Panel Nubefact → API. En prod: Railway Variables (no dejar defaults en código).
NUBEFACT_URL=https://api.nubefact.com/api/v1/TU_RUTA
NUBEFACT_TOKEN=tu_token_nubefact

# --- Datos emisor (factura; pueden coincidir con Nubefact) ---
EMISOR_RUC=20XXXXXXXXX
EMISOR_RAZON_SOCIAL=HATUNSALES S.A.C.
EMISOR_DIRECCION=tu direccion
EMISOR_UBICACION=DISTRITO - PROVINCIA - DEPARTAMENTO
EMISOR_LOGO_URL=

# --- Consulta DNI/RUC (ApiPeru u otro) ---
# Autocompleta DNI/RUC en el POS. El token YA NO está en el código: defínalo en
# Railway (también se aceptan APIPERU_TOKEN, APISPERU_TOKEN o TOKEN_SUNAT) o
# guárdelo en la tabla configuraciones, clave sunat_token (sin redeploy).
# El token anterior quedó en el historial de git: ROTE el token en apiperu.dev.
# Sin token, la consulta responde 503 y el POS permite escribir los datos a mano.
SUNAT_TOKEN=tu_token_consulta
# SUNAT_DNI_URL=https://apiperu.dev/api/dni
# SUNAT_RUC_URL=https://apiperu.dev/api/ruc

# --- Facturación electrónica directa con SUNAT (SEE - Del Contribuyente) ---
# Se configura en el PANEL (Configuración › Facturación electrónica / API /fiscal/*):
# proveedor (nubefact | sunat_directo), ambiente (beta | produccion), series,
# datos del emisor, certificado .pfx (CDT de SUNAT o comprado), usuario y clave
# SOL, credenciales API de la GRE y la confirmación de que no hay OSE.
# Nubefact sigue siendo el proveedor por defecto hasta que lo cambie en el panel.
#
# FISCAL_SECRET_KEY: llave maestra que cifra (AES-256-GCM) el certificado, su
# contraseña, la clave SOL y las credenciales API de la GRE en la base de datos.
#   Genérela UNA vez:   openssl rand -base64 32     (o: openssl rand -hex 32)
#   Póngala en Railway › Variables y GUARDE UNA COPIA OFFLINE (gestor de claves).
#   Si se pierde o cambia sin la anterior, hay que volver a subir el .pfx, la
#   clave SOL y las credenciales API desde el panel. Sin ella la API arranca
#   igual y Nubefact sigue operando, pero SUNAT directo queda deshabilitado.
FISCAL_SECRET_KEY=
# Solo para ROTAR la llave: ponga aquí la llave vieja y en FISCAL_SECRET_KEY la
# nueva; lo guardado se vuelve a cifrar solo al usarse. Luego puede quitarla.
FISCAL_SECRET_KEY_ANTERIOR=
# true = no correr las tareas programadas fiscales (reenvíos, resúmenes, alertas).
FISCAL_TAREAS_DESACTIVADAS=false
# Antes de activar: ejecutar sql/fase9_sunat_directo.sql en Railway (idempotente).

# --- LEGADO: SUNAT Directo BETA por variables (solo specs y pruebas antiguas) ---
# Lo de abajo ya NO controla la emisión real: proveedor, ambiente, series,
# certificado y credenciales SOL se configuran en el panel (ver arriba).
# El flujo real de ventas sigue usando Nubefact (arriba). Esto es un pipeline
# aparte para probar Factura/Boleta/Nota de Crédito/Guía de Remisión directo
# contra SUNAT (src/sunat/*), APAGADO por defecto. Sin SUNAT_DIRECT_ENABLED=true
# nunca intenta nada real (cae siempre a NoopFiscalProvider).
SUNAT_DIRECT_ENABLED=false
SUNAT_FISCAL_PROVIDER=none
# beta | produccion (usar "produccion" solo con certificado real y tras homologación)
SUNAT_FISCAL_ENVIRONMENT=beta
# Credenciales BETA fijas de SUNAT (no requieren Clave SOL real): usuario = RUC+MODDATOS.
# En producción, van el usuario secundario SOL real (perfil "Envío de documentos
# electrónicos-Grandes emisores") y su clave — NUNCA subir esos valores reales a Git.
SUNAT_USERNAME_SUFFIX=MODDATOS
SUNAT_PASSWORD=MODDATOS
# Si se define, sobreescribe el endpoint automático (Factura/Boleta/NC vs Guía) de fiscal-config.ts.
# SUNAT_BILL_ENDPOINT=
SUNAT_TIMEOUT_MS=30000
# Series validas para SUNAT: Factura F###, Boleta B###, Guía T### (la de Nota de
# Crédito depende del documento que modifica, no tiene un default fijo).
# Hoy solo sirven de valor inicial si el panel no tiene series guardadas.
SUNAT_SERIE_FACTURA=F001
SUNAT_SERIE_BOLETA=B001
SUNAT_SERIE_GUIA=T001
# LEGADO: el certificado ahora se SUBE EN EL PANEL (POST /fiscal/certificado) y
# se guarda cifrado en la BD; estas rutas en disco solo las usan pruebas antiguas
# (el disco de Railway es efímero).
SUNAT_CERT_PATH=
SUNAT_CERT_PASSWORD=

# --- Culqi (pagos tienda; vacío = flujo sin pasarela / manual) ---
PASARELA_PROVEEDOR=simulada
PASARELA_MONEDA=PEN
CULQI_URL=https://api.culqi.com/v2
CULQI_PUBLIC_KEY=pk_test_o_pk_live_xxxx
CULQI_SECRET_KEY=sk_test_o_sk_live_xxxx
CULQI_WEBHOOK_SECRET=tu_webhook_secret
CULQI_TIMEOUT_MS=20000

# --- WhatsApp Business Meta Cloud (cotizaciones) — opcional ---
# Sin esto: el front abre wa.me (vendedor envía a mano). Así trabajan la mayoría de ferreterías.
# Con esto: POST /proforma/whatsapp/enviar usa Cloud API oficial (como Culqi: pegar en Railway).
# Meta Business → App → WhatsApp → API Setup → Phone number ID + token permanente.
# Fuera de ventana 24h Meta exige plantilla aprobada con 3 vars: {{1}}nombre {{2}}código {{3}}total.
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# WHATSAPP_GRAPH_URL=https://graph.facebook.com
# WHATSAPP_TEMPLATE_NAME=cotizacion_hatun
# WHATSAPP_TEMPLATE_LANG=es_PE

# --- Google login (opcional) ---
GOOGLE_CLIENT_ID=

# --- Correo al cliente (comprobante por correo; ver doc/PLAN_ENVIO_COMPROBANTE_CORREO.md) ---
# Proveedor: brevo | resend | archivo (por defecto "archivo": escribe cada correo como JSON en .tmp/correos/)
#   Brevo  (https://www.brevo.com): permite verificar solo una dirección remitente, útil sin dominio propio.
#   Resend (https://resend.com): mejor cuando haya dominio propio con SPF/DKIM.
# Además hay que encender la clave `correo_envio_activo` = true en la tabla configuraciones (apagada por defecto)
# y aplicar sql/fase17_comprobante_correos.sql.
CORREO_PROVEEDOR=archivo
CORREO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=
# En comprobantes BETA el correo se desvía a esta dirección (sin ella no se envía nada).
CORREO_DESTINO_PRUEBAS=

# --- Imágenes (local o Cloudinary) ---
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=cloudinary
PRODUCT_IMAGES_PATH=uploads/products
PRODUCT_IMAGES_URL=/uploads
IMAGEN_TAMANIO_MAXIMO=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA=hatunsales/productos

# =============================================================================
# Checklist Railway (servicio Nest)
# =============================================================================
# [ ] JWT_SECRET
# [ ] DATABASE_URL (o PG* / link a Postgres)
# [ ] CORS_ORIGIN = URL exacta del front en Vercel
# [ ] NUBEFACT_URL + NUBEFACT_TOKEN (si emites CPE)
# [ ] CULQI_* (solo si cobras con Culqi)
# [ ] SUNAT_DIRECT_ENABLED + SUNAT_CERT_* (solo si se activa el envío propio a SUNAT sin Nubefact)
# [ ] PORT lo pone Railway solo (no hace falta pelearlo)
#
# Tras cambiar Variables → Redeploy del servicio Nest.
# =============================================================================
